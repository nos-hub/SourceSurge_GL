+bool Wave_RespawnBlocked()
+{
+	// lobby, countdown before wave 1, no session: free respawn
+	if (!g_Wave.locked)
+		return false;
+
+	// retry menu is up: the bots are gone, everybody may respawn again
+	if (g_Wave.state == WAVE_NET_RETRY)
+		return false;
+
+	// waves, pauses between waves, game over, end stats
+	return Wave_LockOn();
+}
