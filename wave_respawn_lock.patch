+// brings one dead / spectating player back with a normal spawn. Works in solo too
+// (Spawn() directly, never the "reload" of the stock single-player respawn).
+static void Wave_RespawnPlayer(CBasePlayer* pPlayer)
+{
+	if (!pPlayer || !Wave_IsConnected(pPlayer))
+		return;
+
+	const bool observer = pPlayer->pev->iuser1 != 0 || (pPlayer->m_afPhysicsFlags & PFLAG_OBSERVER) != 0;
+	if (pPlayer->IsAlive() && !observer)
+		return;
+
+	// leave observer mode (StartObserver / death cam left these set)
+	pPlayer->pev->iuser1 = 0;
+	pPlayer->pev->iuser2 = 0;
+	pPlayer->m_hObserverTarget = NULL;
+	pPlayer->m_iHideHUD = 0;
+	pPlayer->pev->team = 0;
+
+	pPlayer->Spawn();
+	pPlayer->pev->effects |= EF_NOINTERP;
+}
+
